python3 - <<'PY'
import cv2
import time
from ultralytics import YOLO

MODEL = "/home/rnd/Desktop/webcam_round4_best.engine"
CAMERA = "/dev/video0"

model = YOLO(MODEL, task="detect")

cap = cv2.VideoCapture(CAMERA, cv2.CAP_V4L2)
cap.set(cv2.CAP_PROP_FOURCC, cv2.VideoWriter_fourcc(*"MJPG"))
cap.set(cv2.CAP_PROP_FRAME_WIDTH, 640)
cap.set(cv2.CAP_PROP_FRAME_HEIGHT, 480)
cap.set(cv2.CAP_PROP_FPS, 30)

if not cap.isOpened():
    raise RuntimeError("Webcam open failed")

count = 0
start = time.time()

print("Webcam + YOLO started. Ctrl+C to stop.")

try:
    while True:
        ok, frame = cap.read()
        if not ok:
            print("Webcam frame failed")
            continue

        model.predict(
            frame,
            imgsz=640,
            conf=0.35,
            device=0,
            verbose=False
        )

        count += 1

        if count % 30 == 0:
            dt = time.time() - start
            print(f"Webcam YOLO FPS: {count/dt:.1f}")

finally:
    cap.release()
PY
